# ===============================================
# AUTONOMOUS STOCK TRADING SYSTEM CONFIGURATION
# ===============================================

# --- Official eToro API Credentials (Required for Live Trading) ---
# Generate keys from https://api-portal.etoro.com
ETORO_API_KEY=your_etoro_api_key_here
ETORO_USER_KEY=your_etoro_user_jwt_token_here
ETORO_BASE_URL=https://public-api.etoro.com

# --- Execution & Portfolio Mode ---
# Options: "live" (transmits real orders to eToro) or "demo" (simulation)
EXECUTION_MODE=live
INITIAL_CAPITAL=1300.0
MAX_CONCURRENT_POSITIONS=15
MAX_PORTFOLIO_EXPOSURE_PCT=0.85
MIN_CONVICTION_SCORE=0.08

# --- Swing Trading Limits ---
DEFAULT_STOP_LOSS_PCT=0.025
DEFAULT_TAKE_PROFIT_PCT=0.050

# --- Intraday Day Trading & Institutional Risk Engine ---
ENABLE_DAY_TRADING=true
DAY_TRADE_ALLOCATION_PCT=0.35
DAY_TRADE_MAX_ACTIVE=4
DAY_TRADE_STOP_LOSS_PCT=0.012
DAY_TRADE_TAKE_PROFIT_PCT=0.024
MAX_DAILY_LOSS_USD=35.0
DAY_TRADE_EOD_FLATTEN_MINUTES_BEFORE_CLOSE=15

# --- Multi-Provider Market Data & Intelligence Feeds ---
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=
FMP_API_KEY=
ALPHA_VANTAGE_API_KEY=
TAVILY_API_KEY=
SERPAPI_API_KEY=
ANSPIRE_API_KEY=

