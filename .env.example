# ===============================================
# PREDICTIVE EXECUTION COCKPIT CONFIGURATION
# ===============================================

# Finnhub API Key for real-time US quotes & sentiment (leave blank for high-fidelity simulation)
FINNHUB_API_KEY=

# Initial simulated portfolio cash in USD
INITIAL_CAPITAL=10000.0

# Trading parameters
SIMULATION_MODE=true
MAX_POSITION_SIZE_USD=1500.0
RISK_PER_TRADE_PCT=0.02
MAX_PORTFOLIO_EXPOSURE_PCT=0.75
MAX_DRAWDOWN_LIMIT_PCT=0.15
DEFAULT_STOP_LOSS_PCT=0.025
DEFAULT_TAKE_PROFIT_PCT=0.050
EXECUTION_LOOP_INTERVAL=2.0
